{
  "Document header": {
    "prefix": "adoc-header",
    "body": [
      "= ${1:Document title}",
      "${2:Author}, ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      ":toc: left",
      ":toclevels: 3",
      ":sectnums:",
      "",
      "$0"
    ],
    "description": "建立包含目錄與章節編號的 AsciiDoc 文件標頭"
  },
  "Section": {
    "prefix": "section",
    "body": [
      "== ${1:Section title}",
      "",
      "$0"
    ],
    "description": "插入二級章節"
  },
  "Subsection": {
    "prefix": "subsection",
    "body": [
      "=== ${1:Subsection title}",
      "",
      "$0"
    ],
    "description": "插入三級章節"
  },
  "Bullet list": {
    "prefix": "ulist",
    "body": [
      "* ${1:First item}",
      "* ${2:Second item}"
    ],
    "description": "插入項目符號清單"
  },
  "Numbered list": {
    "prefix": "olist",
    "body": [
      ". ${1:First item}",
      ". ${2:Second item}"
    ],
    "description": "插入編號清單"
  },
  "Checklist": {
    "prefix": "checklist",
    "body": [
      "* [ ] ${1:Pending item}",
      "* [x] ${2:Completed item}"
    ],
    "description": "插入核取清單"
  },
  "Source block": {
    "prefix": "source",
    "body": [
      "[source,${1:typescript}]",
      "----",
      "${2:// code}",
      "----",
      "$0"
    ],
    "description": "插入具有語言名稱的原始碼區塊"
  },
  "Example block": {
    "prefix": "example",
    "body": [
      ".${1:Example title}",
      "====",
      "$0",
      "===="
    ],
    "description": "插入範例區塊"
  },
  "Sidebar block": {
    "prefix": "sidebar",
    "body": [
      ".${1:Sidebar title}",
      "****",
      "$0",
      "****"
    ],
    "description": "插入側欄區塊"
  },
  "Admonition": {
    "prefix": "admonition",
    "body": "${1|NOTE,TIP,IMPORTANT,WARNING,CAUTION|}: ${2:Message}",
    "description": "插入單行提示"
  },
  "Admonition block": {
    "prefix": "admonition-block",
    "body": [
      "[${1|NOTE,TIP,IMPORTANT,WARNING,CAUTION|}]",
      "====",
      "$0",
      "===="
    ],
    "description": "插入多行提示區塊"
  },
  "Table": {
    "prefix": "table",
    "body": [
      "[cols=\"${1:1,1}\",options=\"header\"]",
      "|===",
      "|${2:Column 1}",
      "|${3:Column 2}",
      "",
      "|${4:Value 1}",
      "|${5:Value 2}",
      "|==="
    ],
    "description": "插入具有標題列的表格"
  },
  "Image block": {
    "prefix": "image",
    "body": "image::${1:images/image.png}[${2:Alt text}]",
    "description": "插入區塊圖片"
  },
  "Inline image": {
    "prefix": "image-inline",
    "body": "image:${1:images/icon.png}[${2:Alt text}]",
    "description": "插入行內圖片"
  },
  "Link": {
    "prefix": "link",
    "body": "link:${1:https://example.com}[${2:Link text}]",
    "description": "插入外部連結"
  },
  "Cross reference": {
    "prefix": "xref",
    "body": "xref:${1:document.adoc}#${2:anchor}[${3:Link text}]",
    "description": "插入跨文件引用"
  },
  "Anchor": {
    "prefix": "anchor",
    "body": "[[${1:anchor-id}]]",
    "description": "插入明確 Anchor"
  },
  "Include": {
    "prefix": "include",
    "body": "include::${1:partial.adoc}[${2}]",
    "description": "插入 Include"
  },
  "Document attribute": {
    "prefix": "attribute",
    "body": ":${1:name}: ${2:value}",
    "description": "插入文件屬性"
  },
  "Page break": {
    "prefix": "page-break",
    "body": "<<<",
    "description": "插入分頁符號"
  }
}
