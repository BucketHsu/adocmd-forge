{
  "name": "adocmd-forge",
  "displayName": "AdocMD Forge",
  "description": "Secure live preview for AsciiDoc and Markdown with synchronized scrolling and VS Code theme support.",
  "version": "1.2.5",
  "publisher": "BucketHsu",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/BucketHsu/adocmd-forge.git"
  },
  "bugs": {
    "url": "https://github.com/BucketHsu/adocmd-forge/issues"
  },
  "homepage": "https://github.com/BucketHsu/adocmd-forge#readme",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "asciidoc",
    "markdown",
    "preview",
    "documentation"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview rendering and local document stylesheets remain available, but local includes, local images, local link navigation, and remote images are disabled until the workspace is trusted."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:asciidoc",
    "onLanguage:markdown",
    "onCommand:adocmdForge.openSyntaxGuide",
    "onCommand:adocmdForge.showFormattingPalette",
    "onCommand:adocmdForge.formatBold",
    "onCommand:adocmdForge.formatItalic",
    "onCommand:adocmdForge.formatHighlight",
    "onCommand:adocmdForge.formatCode",
    "onCommand:adocmdForge.formatStrike",
    "onCommand:adocmdForge.formatSuperscript",
    "onCommand:adocmdForge.formatSubscript",
    "onCommand:adocmdForge.copyImage",
    "onCommand:adocmdForge.validateLinks",
    "onView:adocmdForge.outline",
    "onCommand:adocmdForge.refreshOutline",
    "onCommand:adocmdForge.exportHtml",
    "onCommand:adocmdForge.exportStandaloneHtml",
    "onCommand:adocmdForge.exportEmbeddedHtml",
    "onCommand:adocmdForge.exportPdf",
    "onCommand:adocmdForge.previewSource",
    "onCommand:adocmdForge.previewSplit",
    "onCommand:adocmdForge.previewOnly"
  ],
  "contributes": {
    "commands": [
      {
        "command": "adocmdForge.openPreview",
        "title": "Open Preview",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.refreshPreview",
        "title": "Refresh Preview",
        "category": "AdocMD Forge"
      },
      {
        "command": "adocmdForge.previewSource",
        "title": "Source Only",
        "category": "AdocMD Forge",
        "icon": "$(file-text)"
      },
      {
        "command": "adocmdForge.previewSplit",
        "title": "Source and Preview",
        "category": "AdocMD Forge",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "adocmdForge.previewOnly",
        "title": "Preview Only",
        "category": "AdocMD Forge",
        "icon": "$(preview)"
      },
      {
        "command": "adocmdForge.showFormattingPalette",
        "title": "Show Formatting Palette",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc",
        "icon": "$(symbol-color)"
      },
      {
        "command": "adocmdForge.formatBold",
        "title": "Bold",
        "category": "AdocMD Forge",
        "icon": "$(bold)"
      },
      {
        "command": "adocmdForge.formatItalic",
        "title": "Italic",
        "category": "AdocMD Forge",
        "icon": "$(italic)"
      },
      {
        "command": "adocmdForge.formatHighlight",
        "title": "Highlight",
        "category": "AdocMD Forge",
        "icon": "$(symbol-color)"
      },
      {
        "command": "adocmdForge.formatCode",
        "title": "Inline Code",
        "category": "AdocMD Forge",
        "icon": "$(code)"
      },
      {
        "command": "adocmdForge.formatStrike",
        "title": "Strike Through",
        "category": "AdocMD Forge",
        "icon": "$(remove)"
      },
      {
        "command": "adocmdForge.formatSuperscript",
        "title": "Superscript",
        "category": "AdocMD Forge",
        "icon": "$(symbol-number)"
      },
      {
        "command": "adocmdForge.formatSubscript",
        "title": "Subscript",
        "category": "AdocMD Forge",
        "icon": "$(symbol-number)"
      },
      {
        "command": "adocmdForge.openSyntaxGuide",
        "title": "Open AsciiDoc Syntax Guide",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.copyImage",
        "title": "Copy Image",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.refreshOutline",
        "title": "Refresh Outline",
        "category": "AdocMD Forge"
      },
      {
        "command": "adocmdForge.validateLinks",
        "title": "Validate Links",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.exportHtml",
        "title": "Export HTML",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.exportStandaloneHtml",
        "title": "Export Standalone HTML",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.exportEmbeddedHtml",
        "title": "Export Embedded HTML",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.exportPdf",
        "title": "Export PDF",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == asciidoc",
        "icon": "$(file-pdf)"
      }
    ],
    "configuration": {
      "title": "AdocMD Forge",
      "properties": {
        "adocmdForge.preview.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Allow previews to load HTTPS images from remote servers. Disabled in untrusted workspaces."
        },
        "adocmdForge.preview.openToSide": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Open document previews beside the active editor."
        },
        "adocmdForge.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Synchronize scrolling between the source editor and its preview."
        },
        "adocmdForge.preview.updateDelay": {
          "type": "number",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before updating a preview after editing."
        },
        "adocmdForge.images.directory": {
          "type": "string",
          "default": "images",
          "scope": "resource",
          "description": "Relative image directory beside the current document. Path traversal and absolute paths are rejected."
        },
        "adocmdForge.images.promptForPath": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Ask for the image destination before inserting an image."
        },
        "adocmdForge.images.defaultAltText": {
          "type": "string",
          "default": "filename",
          "scope": "resource",
          "description": "Default image alt text. Use filename to derive it from the saved image name."
        },
        "adocmdForge.outline.updateDelay": {
          "type": "number",
          "default": 150,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before updating the Outline after editing."
        },
        "adocmdForge.diagnostics.updateDelay": {
          "type": "number",
          "default": 150,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before validating local links after editing."
        },
        "adocmdForge.export.asciidoctorPdfCommand": {
          "type": "string",
          "default": "asciidoctor-pdf",
          "scope": "resource",
          "description": "Executable used by Export PDF. The command must be installed on the local machine."
        },
        "adocmdForge.export.asciidoctorPdfArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional asciidoctor-pdf arguments. Use {source}, {destination}, and {workspace} placeholders; omitted paths are appended automatically."
        }
      }
    },
    "languages": [
      {
        "id": "asciidoc",
        "aliases": [
          "AsciiDoc",
          "asciidoc"
        ],
        "extensions": [
          ".adoc",
          ".asciidoc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "adocmdForge.openPreview",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@10"
        },
        {
          "command": "adocmdForge.refreshPreview",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@11"
        },
        {
          "command": "adocmdForge.previewSource",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@12"
        },
        {
          "command": "adocmdForge.previewSplit",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@13"
        },
        {
          "command": "adocmdForge.previewOnly",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@14"
        },
        {
          "command": "adocmdForge.openSyntaxGuide",
          "when": "editorLangId == asciidoc",
          "group": "navigation@25"
        },
        {
          "command": "adocmdForge.validateLinks",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@26"
        },
        {
          "command": "adocmdForge.copyImage",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@27"
        },
        {
          "command": "adocmdForge.exportHtml",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@28"
        },
        {
          "command": "adocmdForge.exportStandaloneHtml",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@29"
        },
        {
          "command": "adocmdForge.exportEmbeddedHtml",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "navigation@30"
        },
        {
          "command": "adocmdForge.exportPdf",
          "when": "editorLangId == asciidoc",
          "group": "navigation@31"
        }
      ],
      "editor/context": [
        {
          "command": "adocmdForge.showFormattingPalette",
          "when": "editorLangId == markdown || editorLangId == asciidoc",
          "group": "2_modification@0"
        },
        {
          "command": "adocmdForge.formatBold",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@1"
        },
        {
          "command": "adocmdForge.formatItalic",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@2"
        },
        {
          "command": "adocmdForge.formatHighlight",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@3"
        },
        {
          "command": "adocmdForge.formatCode",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@4"
        },
        {
          "command": "adocmdForge.formatStrike",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@5"
        },
        {
          "command": "adocmdForge.formatSuperscript",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@6"
        },
        {
          "command": "adocmdForge.formatSubscript",
          "when": "editorHasSelection && (editorLangId == markdown || editorLangId == asciidoc)",
          "group": "2_modification@7"
        }
      ],
      "view/title": [
        {
          "command": "adocmdForge.refreshOutline",
          "when": "view == adocmdForge.outline",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "adocmdForge.outline",
          "name": "Outline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && node scripts/run-integration-tests.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run test:unit:coverage && npm run build && npm run package:list",
    "verify": "npm run check && npm run test:integration",
    "package:list": "node scripts/package-list.mjs",
    "package:vsix": "node scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "20.19.43",
    "@types/sanitize-html": "2.16.1",
    "@types/vscode": "1.97.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar": false
  },
  "dependencies": {
    "@asciidoctor/core": "3.0.4",
    "markdown-it": "14.3.0",
    "sanitize-html": "2.17.6"
  },
  "overrides": {
    "@asciidoctor/opal-runtime": {
      "glob": "13.0.6"
    }
  }
}
