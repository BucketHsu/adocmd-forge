{
  "name": "adocmd-forge",
  "displayName": "AdocMD Forge",
  "description": "Secure live preview for AsciiDoc and Markdown with synchronized scrolling and VS Code theme support.",
  "version": "0.0.1",
  "publisher": "BucketHsu",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/BucketHsu/adocmd-forge.git"
  },
  "bugs": {
    "url": "https://github.com/BucketHsu/adocmd-forge/issues"
  },
  "homepage": "https://github.com/BucketHsu/adocmd-forge#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "asciidoc",
    "markdown",
    "preview",
    "documentation"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview rendering remains available, but local includes, local images, local link navigation, and remote images are disabled until the workspace is trusted."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:asciidoc",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "adocmdForge.openPreview",
        "title": "Open Preview",
        "category": "AdocMD Forge",
        "enablement": "editorLangId == markdown || editorLangId == asciidoc"
      },
      {
        "command": "adocmdForge.refreshPreview",
        "title": "Refresh Preview",
        "category": "AdocMD Forge"
      }
    ],
    "configuration": {
      "title": "AdocMD Forge",
      "properties": {
        "adocmdForge.preview.allowRemoteImages": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Allow previews to load HTTPS images from remote servers. Disabled in untrusted workspaces."
        },
        "adocmdForge.preview.openToSide": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Open document previews beside the active editor."
        },
        "adocmdForge.preview.scrollSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Synchronize scrolling between the source editor and its preview."
        },
        "adocmdForge.preview.updateDelay": {
          "type": "number",
          "default": 200,
          "minimum": 50,
          "maximum": 2000,
          "scope": "resource",
          "description": "Delay in milliseconds before updating a preview after editing."
        }
      }
    },
    "languages": [
      {
        "id": "asciidoc",
        "aliases": [
          "AsciiDoc",
          "asciidoc"
        ],
        "extensions": [
          ".adoc",
          ".asciidoc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "adocmdForge.openPreview",
          "when": "resourceLangId == markdown || resourceLangId == asciidoc",
          "group": "navigation@10"
        },
        {
          "command": "adocmdForge.refreshPreview",
          "when": "resourceLangId == markdown || resourceLangId == asciidoc",
          "group": "navigation@11"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run build && npm run compile:integration && node scripts/run-integration-tests.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run typecheck && npm run lint && npm run test:unit:coverage && npm run build",
    "verify": "npm run check && npm run test:integration",
    "package:list": "vsce ls --no-dependencies",
    "package:vsix": "node scripts/package-vsix.mjs",
    "vscode:prepublish": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "20.19.43",
    "@types/sanitize-html": "2.16.1",
    "@types/vscode": "1.96.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar": false
  },
  "dependencies": {
    "@asciidoctor/core": "3.0.4",
    "markdown-it": "14.3.0",
    "sanitize-html": "2.17.6"
  },
  "overrides": {
    "@asciidoctor/opal-runtime": {
      "glob": "13.0.6"
    }
  }
}
